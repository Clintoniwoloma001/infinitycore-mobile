# Built binaries — never committed. The single deliverable release APK is
# produced by `shorebird release android` and lives under build/ (ignored).
*.apk
*.aab
*.ipa
/dist/
/outputs/
/apps/
/artifacts/

# Shorebird local state (the app_id in shorebird.yaml IS tracked)
.shorebird/
shorebird-*.log

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
.env

# ---------------------------------------------------------------------------
# RELEASE SIGNING SECRETS — never commit these
# ---------------------------------------------------------------------------
# The passwords. `key.properties.example` is the committed template.
android/key.properties

# The keystore itself. A leaked upload key lets anyone sign an update that
# Android will accept as yours, which is why it is excluded even though the
# original file was provided in the project directory. Keep the real file out
# of git and distribute it through a secure channel.
android/upload-keystore.jks
upload-keystore.jks
*.jks
*.keystore
