migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Built binaries — never committed. The single deliverable release APK is
# produced by `shorebird release android` and lives under build/ (ignored).
*.apk
*.aab
*.ipa
/dist/
/outputs/
/apps/
/artifacts/

# Shorebird local state (the app_id in shorebird.yaml IS tracked)
.shorebird/
shorebird-*.log

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
.env
